{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile, progress, and gamification data",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email" },
        "school": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastActive": { "type": "string", "format": "date-time" },
        "xp": { "type": "integer" },
        "level": { "type": "integer" },
        "role": { "type": "string", "enum": ["student", "teacher", "admin"] },
        "points": { "type": "integer" },
        "progress": { "type": "object" },
        "streak": { "type": "integer" },
        "achievements": { "type": "array" }
      },
      "required": ["name", "createdAt", "lastActive", "xp", "level"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin identity whitelist records",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "assignedAt": { "type": "string", "format": "date-time" },
        "assignedBy": { "type": "string" }
      },
      "required": ["uid", "assignedAt"]
    },
    "Lesson": {
      "title": "Lesson",
      "description": "AI-generated educational lesson content",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 500 },
        "topicId": { "type": "string" },
        "topicName": { "type": "string" },
        "introduction": { "type": "string" },
        "detailedExplanation": { "type": "string" },
        "miniSummary": { "type": "string" },
        "quiz": { "type": "array" }
      },
      "required": ["title", "detailedExplanation", "quiz"]
    },
    "Discussion": {
      "title": "Discussion",
      "description": "Community messages",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "text": { "type": "string", "maxLength": 500 },
        "likes": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "text", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Admin whitelist documents"
    },
    "/lessons/{lessonId}": {
      "schema": "Lesson",
      "description": "Lesson content documents"
    },
    "/discussions/{msgId}": {
      "schema": "Discussion",
      "description": "Community discussion messages"
    }
  }
}
